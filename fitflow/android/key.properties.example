# Copy this file to android/key.properties and fill in your own upload key.
# key.properties is gitignored. Never commit a real keystore, password, or PAT.
#
# storeFile is resolved from android/app/ (an absolute path is also accepted).
# Create the upload key locally in Android Studio or keytool. Arena must not
# generate it.
storeFile=REPLACE_WITH_KEYSTORE_PATH
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
keyPassword=REPLACE_WITH_KEY_PASSWORD

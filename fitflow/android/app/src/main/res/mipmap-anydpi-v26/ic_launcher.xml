<?xml version="1.0" encoding="utf-8"?>
<!-- Home Workout launcher icon (Android 8.0+).
     Foreground: the approved artwork, drawn at 73/108 of the canvas so both
     characters, the house symbol and the dumbbell stay inside the 72 dp safe
     area for every launcher mask.
     Background: matching dark green field, from the artwork's own palette.
     Legacy ic_launcher.png in each mipmap-<density> folder covers API 25 and
     below. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
